# Clerk authentication — get from https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend API base URL
EXPO_PUBLIC_API_URL=https://your-api.example.com/api

# Payment configuration
EXPO_PUBLIC_PAYMENT_PROVIDER=razorpay
EXPO_PUBLIC_PAYMENT_MODE=sandbox

# Accent color picker — set to "true" to show the picker in
# Privacy & Security settings. "false" (or unset) hides it and
# the app uses the default `primary` token (blue) everywhere.
EXPO_PUBLIC_ENABLE_ACCENT_PICKER=true
